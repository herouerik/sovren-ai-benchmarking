.venv/
results/*.json
results/**/*.json
!results/sample.json
# Compact aggregate of a run (~20KB): keeps a committed dashboard reproducible
# without tracking the multi-MB per-sample records.
!results/*.summary.json
results/*.log
results/report.html
results/**/report.html
# Per-run dashboards are generated by every bare run and accumulate; only the
# named milestone reports (report_final, report_v1_baseline_*) are tracked.
results/report_2*.html
# Regenerated by merge_summaries.py on every merge; the payload it renders
# (results/merged.summary.json) is what's tracked.
results/report_merged.html
__pycache__/
*.pyc
*.pyo
.DS_Store
.datasets_ready
config.yaml
config-eh*

docs_steering/

lib/
lib64/
data/spider/

# BFCL v4 dataset, extracted from the bfcl-eval wheel by prefetch_datasets.py
data/bfcl_v4/
