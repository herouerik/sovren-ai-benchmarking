.venv/
results/*.json
!results/sample.json
# Compact aggregate of a run (~20KB): keeps a committed dashboard reproducible
# without tracking the multi-MB per-sample records.
!results/*.summary.json
results/*.log
results/report.html
# Per-run dashboards are generated by every bare run and accumulate; only the
# named milestone reports (report_final, report_v1_baseline_*) are tracked.
results/report_2*.html
__pycache__/
*.pyc
*.pyo
.DS_Store
.datasets_ready
config.yaml
config-eh*

docs_steering/

lib/
lib64/
data/spider/
